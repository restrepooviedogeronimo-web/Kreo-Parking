doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Iniciar Sesión | Kreo
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/kreo-theme.css")
  body.d-flex.align-items-center.justify-content-center.min-vh-100
    .container(style="max-width: 480px;")
      .text-center.mb-4
        a.text-decoration-none(href="/")
          h1.fw-bolder.text-white 
            i.bi.bi-ev-front-fill.text-kreo.me-2
            | KRE<span class="text-kreo">O</span>
      
      .card-glass.p-5
        h3.fw-bold.text-white.text-center.mb-4 Iniciar Sesión
        
        if error
          .alert.alert-danger.bg-transparent.border-danger.text-danger.fw-bold.mb-3= error
        if mensaje
          .alert.alert-success.bg-transparent.border-success.text-kreo.fw-bold.mb-3= mensaje

        form(action="/login" method="POST")
          .mb-3
            label.form-label.text-kreo.fw-bold Documento de Identidad (Cliente) o Correo
            input.form-control.bg-dark.border-secondary.text-white(type="text" name="identificacion" required placeholder="Ej: 1000123456")
          .mb-4
            label.form-label.text-kreo.fw-bold Contraseña <span class="text-white-50 small">(Solo Personal Admin / Operario)</span>
            input.form-control.bg-dark.border-secondary.text-white(type="password" name="contrasena" placeholder="Déjala en blanco si eres Cliente")
          
          button.btn.btn-kreo.w-100.py-2.mt-2(type="submit") Entrar a mi Cuenta

        hr.border-secondary.my-4
        
        .text-center
          p.text-white.fw-bold.mb-2 Accesos Directos por Rol (Pruebas):
          .d-flex.justify-content-center.gap-2
            a.btn.btn-outline-danger.btn-sm.px-3(href="/test-role/1") 👑 Admin
            a.btn.btn-outline-danger.btn-sm.px-3(href="/test-role/2") 🚗 Operario
            a.btn.btn-outline-danger.btn-sm.px-3(href="/test-role/3") 👤 Cliente
          
        .text-center.mt-4
          a.text-warning.text-decoration-none(href="/registro") ¿No tienes cuenta? Regístrate aquí