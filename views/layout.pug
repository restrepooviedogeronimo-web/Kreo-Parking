doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Dashboard | Kreo
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/kreo-theme.css")
  body
    .layout-wrapper
      nav.sidebar
        .px-3.mb-4.d-flex.align-items-center
          i.bi.bi-ev-front-fill.text-kreo.fs-3.min-width-icon.ms-1
          span.brand-title.fw-bolder.fs-4.text-white.ms-2 KRE<span class="text-kreo">O</span>

        ul.nav.flex-column.w-100.flex-grow-1
          li.nav-item
            a.nav-link(href="/dashboard" title="Resumen General")
              i.bi.bi-speedometer2
              span.ms-2 Dashboard
          
          if usuario.rol_id === 1
            li.nav-item
              a.nav-link(href="/usuarios" title="Gestión Usuarios / Kill Switch")
                i.bi.bi-people-fill
                span.ms-2 Gestión Usuarios
            li.nav-item
              a.nav-link(href="/finanzas" title="Auditoría & Tarifas")
                i.bi.bi-cash-coin
                span.ms-2 Finanzas & Tarifas

          if usuario.rol_id === 2
            li.nav-item
              a.nav-link(href="/operaciones" title="Control Vehicular")
                i.bi.bi-car-front-fill
                span.ms-2 Control Operativo

          if usuario.rol_id === 3
            li.nav-item
              a.nav-link(href="/perfil" title="Mi Perfil")
                i.bi.bi-person-vcard
                span.ms-2 Mi Perfil
            li.nav-item
              a.nav-link(href="/mis-vehiculos" title="Mis Vehículos & Wallet")
                i.bi.bi-wallet2
                span.ms-2 Mis Vehículos & Wallet

        .px-3.sidebar-footer.mt-auto
          a.btn.btn-outline-danger.w-100.d-flex.align-items-center.justify-content-center(href="/logout" title="Cerrar Sesión")
            i.bi.bi-box-arrow-left.fs-5
            span.ms-2 Salir

      main.content-area
        block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")