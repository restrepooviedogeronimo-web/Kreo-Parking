                  .col-6: img(src="https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=500&q=80" alt="Bahía de parqueo")
                  .col-6: img(src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=80" alt="Autos seguros")
                  .col-6: img(src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=500&q=80" alt="Instalaciones")
                
                .p-3.bg-dark.rounded.border.border-secondary
                  .d-flex.justify-content-between.text-white.small.mb-1
                    <span>Índice de Satisfacción del Cliente:</span>
                    <strong class="text-success">98.4% ⭐⭐⭐⭐⭐</strong>
                  .d-flex.justify-content-between.text-white.small
                    <span>Tiempo promedio de ingreso:</span>
                    <strong class="text-kreo">18 Segundos (Express)</strong>

          //- SEDE 2: SEDE NORTE
          .col-md-6
            .card-glass.p-4.h-100.clickable-card(onclick="toggleExpand('sede2-content', this)")
              .d-flex.justify-content-between.align-items-center
                h4.text-kreo.fw-bold.mb-0 <i class="bi bi-geo-alt-fill me-2"></i> Sede Norte - Expansión Kreo
                i.bi.bi-chevron-down.text-white.fs-5
              p.text-white.opacity-90.mt-3 <strong>Dirección exacta:</strong> Carrera 15 # 78-40 (Cerca al Centro Financiero).
              p.text-white.opacity-90 <strong>Horario:</strong> 24 Horas / 7 Días a la Semana.
              span.badge.bg-success Capacidad: 85 Celdas (Exclusivo Autos)
              
              div.expandable-content(id="sede2-content")
                hr.border-secondary.my-3
                h6.text-kreo.fw-bold Mini Mapa Interactivo
                .ratio.ratio-16x9.mb-3.rounded.overflow-hidden.border.border-secondary
                  iframe(src="https://www.openstreetmap.org/export/embed.html?bbox=-75.59,6.25,-75.57,6.27&layer=mapnik" style="border:0;")
                
                h6.text-kreo.fw-bold.mt-3 Galería de la Sede & Satisfacción
                .row.g-2.mini-slider.mb-3
                  .col-6: img(src="https://images.unsplash.com/photo-1508962914676-134849a727f0?auto=format&fit=crop&w=500&q=80" alt="Sede Norte Exterior")
                  .col-6: img(src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=80" alt="Sótano ejecutivo")
                  .col-6: img(src="https://images.unsplash.com/photo-1590674899484-d5640e854abe?auto=format&fit=crop&w=500&q=80" alt="Zona de espera")
                  .col-6: img(src="https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=500&q=80" alt="Tecnología QR")
                
                .p-3.bg-dark.rounded.border.border-secondary
                  .d-flex.justify-content-between.text-white.small.mb-1
                    <span>Índice de Satisfacción del Cliente:</span>
                    <strong class="text-success">99.1% ⭐⭐⭐⭐⭐</strong>
                  .d-flex.justify-content-between.text-white.small
                    <span>Disponibilidad nocturna:</span>
                    <strong class="text-kreo">100% Monitoreado</strong>

    //- 3. RESEÑAS DE CLIENTES
    section.py-5.border-top.border-secondary
      .container.py-5.text-center
        h2.fw-bold.mb-5 Lo que dicen nuestros <span class="text-kreo">Usuarios</span>
        .row.g-4
          .col-md-4
            .card-glass.p-4.text-start.h-100
              .text-warning.mb-2 <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
              p.text-white.opacity-90 "Entrar solo mostrando mi documento es lo mejor que le pudo pasar al parqueadero. Ya no hago filas ni pierdo tickets."
              small.text-kreo.fw-bold - Carlos Mendoza (Cliente Frecuente)
          .col-md-4
            .card-glass.p-4.text-start.h-100
              .text-warning.mb-2 <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
              p.text-white.opacity-90 "Recargar la Wallet y pagar automático es excelente. Además el servicio de lavado ecológico mientras trabajo es un puntazo."
              small.text-kreo.fw-bold - Andrea Restrepo (Mensualidad)
          .col-md-4
            .card-glass.p-4.text-start.h-100
              .text-warning.mb-2 <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
              p.text-white.opacity-90 "La interfaz es rapidísima y muy moderna. Da gusto ver proyectos del SENA con este nivel de ingeniería web."
              small.text-kreo.fw-bold - Ing. Camilo Torres (Invitado)

    footer.text-center.py-4.border-top.border-secondary.bg-black
      p.text-white.opacity-70.small © 2026 Kreo Fintech Parking. Todos los derechos reservados.

    script.
      // Función para alternar el despliegue fluido de las tarjetas
      function toggleExpand(contentId, cardElement) {
        const content = document.getElementById(contentId);
        // Cierra otros contenidos abiertos opcionalmente si deseas efecto acordeón exclusivo, 
        // aquí permitimos abrir múltiples de forma independiente.
        content.classList.toggle('open');
        
        // Rota la flecha si la tarjeta tiene icono de chevron
        const icon = cardElement.querySelector('.bi-chevron-down');
        if(icon) {
          icon.style.transform = content.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
          icon.style.transition = 'transform 0.3s ease';
        }
      }