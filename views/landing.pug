doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Kreo | Parqueadero Inteligente & Fintech
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/kreo-theme.css")
    style.
      /* Estilos para el despliegue fluido */
      .expandable-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
        opacity: 0;
      }
      .expandable-content.open {
        max-height: 1200px;
        opacity: 1;
      }
      .clickable-card {
        cursor: pointer;
        transition: transform 0.3s ease, border-color 0.3s ease;
      }
      .clickable-card:hover {
        border-color: var(--primary-red);
      }
      .mini-slider img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
      }
  body
    nav.navbar.navbar-dark.fixed-top.bg-dark.bg-opacity-95.border-bottom.border-secondary.py-3
      .container
        a.navbar-brand.fw-bolder.fs-3.d-flex.align-items-center(href="/")
          i.bi.bi-ev-front-fill.text-kreo.fs-2.me-2
          | KRE<span class="text-kreo">O</span>
        div.d-flex.align-items-center.gap-3
          a.nav-link.text-white.d-none.d-md-inline(href="/beneficios") Beneficios
          a.btn.btn-outline-light.rounded-pill.px-4(href="/login") Iniciar Sesión
          a.btn.btn-kreo(href="/registro") Registrarse

    //- 1. HERO Y TARJETAS DE HISTORIA / VISIÓN (Con Despliegue y 4 Fotos)
    section.hero-landing.py-5.mt-5.text-center
      .container.py-5
        .row.justify-content-center
          .col-lg-10
            span.badge.bg-kreo.px-3.py-2.rounded-pill.mb-3 Innovación Tecnológica SENA
            h1.display-3.fw-bolder.text-white.mb-4 El Ecosistema Digital de <br><span class="text-kreo">Parqueadero La Bahía</span>
            p.lead.text-white.mb-5 Transformamos la gestión tradicional de vehículos en una experiencia completamente automatizada, segura y basada en finanzas digitales.
            
            .row.g-4.text-start.mt-4
              
              //- TARJETA 1: HISTORIA (Desplegable con 4 fotos)
              .col-md-6
                .card-glass.p-4.h-100.clickable-card(onclick="toggleExpand('historia-content', this)")
                  .d-flex.justify-content-between.align-items-center
                    h4.text-kreo.fw-bold.mb-0 <i class="bi bi-book-half me-2"></i> Nuestra Historia
                    i.bi.bi-chevron-down.text-white.fs-5.transition-icon(id="icon-historia")
                  p.text-white.mt-3.opacity-90 Kreo surge como un proyecto formativo de desarrollo de software en el SENA[cite: 3], evolucionando hacia un sistema de gestión inteligente... <span class="text-kreo fw-bold">Haz clic para expandir</span>
                  
                  div.expandable-content(id="historia-content")
                    hr.border-secondary.my-3
                    p.text-white.opacity-100.small Nativos de la colaboración académica, estructuramos una solución que digitalizó por completo los sótanos y áreas de parqueo, interconectando operadores y clientes corporativos mediante bases de datos optimizadas.
                    //- 4 Fotos de Historia (Slider o Mini Grid)
                    .row.g-2.mt-3.mini-slider
                      .col-6: img(src="https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=500&q=80" alt="Sótano Parqueadero")
                      .col-6: img(src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=500&q=80" alt="Trato en sótano")
                      .col-6: img(src="https://images.unsplash.com/photo-1573164713988-8665fc963095?auto=format&fit=crop&w=500&q=80" alt="Desarrollo Software SENA")
                      .col-6: img(src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=500&q=80" alt="Infraestructura Moderna")

              //- TARJETA 2: VISIÓN Y MISIÓN (Desplegable con 4 fotos)
              .col-md-6
                .card-glass.p-4.h-100.clickable-card(onclick="toggleExpand('vision-content', this)")
                  .d-flex.justify-content-between.align-items-center
                    h4.text-kreo.fw-bold.mb-0 <i class="bi bi-eye-fill me-2"></i> Visión y Misión Conjunta
                    i.bi.bi-chevron-down.text-white.fs-5(id="icon-vision")
                  p.text-white.mt-3.opacity-90 Parqueadero La Bahía y Kreo unieron visión y misión para fusionar la infraestructura física con un software... <span class="text-kreo fw-bold">Haz clic para expandir</span>
                  
                  div.expandable-content(id="vision-content")
                    hr.border-secondary.my-3
                    p.text-white.opacity-100.small Garantizamos que cada conductor experimente seguridad absoluta y optimización de su tiempo mediante flujos ininterrumpidos de cobro por Wallet y control de aforo en tiempo real.
                    .row.g-2.mt-3.mini-slider
                      .col-6: img(src="https://images.unsplash.com/photo-1590674899484-d5640e854abe?auto=format&fit=crop&w=500&q=80" alt="Reunión ejecutiva parqueadero")
                      .col-6: img(src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=80" alt="Vehículos seguros")
                      .col-6: img(src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=80" alt="Cierre de negocios")
                      .col-6: img(src="https://images.unsplash.com/photo-1508962914676-134849a727f0?auto=format&fit=crop&w=500&q=80" alt="Tecnología Kreo")

            .mt-5.d-flex.justify-content-center.gap-3
              a.btn.btn-kreo.btn-lg(href="/registro") ¡Crea tu Cuenta Gratis!
              a.btn.btn-outline-danger.btn-lg.rounded-pill.px-5(href="/beneficios") Ver Beneficios <i class="bi bi-arrow-right ms-2"></i>

    //- 2. SEDES ESTRATÉGICAS (Con Mini Mapa Desplegable y 4 Fotos + Satisfacción)
