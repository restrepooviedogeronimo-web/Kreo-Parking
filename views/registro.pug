doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Registro | Kreo
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/kreo-theme.css")
  body.d-flex.align-items-center.justify-content-center.min-vh-100
    .container(style="max-width: 480px;")
      .text-center.mb-4
        a.text-decoration-none(href="/")
          h1.fw-bolder.text-white 
            i.bi.bi-ev-front-fill.text-kreo.me-2
            | KRE<span class="text-kreo">O</span>
      
      .card-glass.p-5
        h3.fw-bold.text-white.text-center.mb-4 Registro de Cliente
        
        if error
          .alert.alert-danger.bg-transparent.border-danger.text-danger.fw-bold.mb-3= error

        form(action="/registro" method="POST")
          .mb-3
            label.form-label.text-kreo.fw-bold Nombre Completo
            input.form-control.bg-dark.border-secondary.text-white(type="text" name="nombre" required placeholder="Tu nombre")
          .mb-3
            label.form-label.text-kreo.fw-bold Número de Documento
            input.form-control.bg-dark.border-secondary.text-white(type="number" name="documento" required placeholder="Tu cédula")
          .mb-4
            label.form-label.text-kreo.fw-bold Correo Electrónico
            input.form-control.bg-dark.border-secondary.text-white(type="email" name="correo" required placeholder="tucorreo@email.com")
          
          button.btn.btn-kreo.w-100.py-2.mt-2(type="submit") Registrarme Ahora
          
        .text-center.mt-4
          a.text-warning.text-decoration-none(href="/login") ¿Ya tienes cuenta? Inicia sesión aquí