doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Beneficios Exclusivos | Kreo
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/kreo-theme.css")
  body
    nav.navbar.navbar-dark.fixed-top.bg-dark.bg-opacity-90.border-bottom.border-secondary.py-3
      .container
        a.navbar-brand.fw-bolder.fs-3.d-flex.align-items-center(href="/")
          i.bi.bi-ev-front-fill.text-kreo.fs-2.me-2
          | KRE<span class="text-kreo">O</span>
        div.d-flex.align-items-center.gap-3
          a.btn.btn-outline-light.rounded-pill.px-4(href="/login") Iniciar Sesión
          a.btn.btn-kreo(href="/registro") Registrarse

    .container.py-5.mt-5.text-center
      h1.display-3.fw-bolder.text-white.mb-3 Beneficios <span class="text-kreo">Exclusivos Kreo</span>
      p.text-white.opacity-80.lead.mb-5 Conoce las 4 ventajas principales diseñadas para optimizar tu experiencia en el Parqueadero La Bahía.

      .col-lg-8.mx-auto.text-start
        .slider-container.p-5
          .slide-item.active
            .d-flex.align-items-center.mb-3
              i.bi.bi-qr-code-scan.fs-1.text-kreo.me-3
              h3.fw-bold.text-white.mb-0 1. Acceso Express por Documento
            p.text-white.opacity-90.fs-5 Olvídate de los molestos tickets de papel y las filas. Identifícate de forma inmediata con tu documento y tu código QR personal.

          .slide-item
            .d-flex.align-items-center.mb-3
              i.bi.bi-wallet2.fs-1.text-kreo.me-3
              h3.fw-bold.text-white.mb-0 2. Billetera Digital (Wallet)
            p.text-white.opacity-90.fs-5 Recarga saldo digitalmente, paga tarifas por hora o mensualidades automáticas y recibe beneficios por fidelidad.

          .slide-item
            .d-flex.align-items-center.mb-3
              i.bi.bi-car-front-fill.fs-1.text-kreo.me-3
              h3.fw-bold.text-white.mb-0 3. Monitoreo en Tiempo Real
            p.text-white.opacity-90.fs-5 Consulta desde tu panel el estado exacto de tu vehículo, historial de ingresos y tiempo de permanencia con precisión.

          .slide-item
            .d-flex.align-items-center.mb-3
              i.bi.bi-shield-lock-fill.fs-1.text-kreo.me-3
              h3.fw-bold.text-white.mb-0 4. Seguridad e Inmutabilidad
            p.text-white.opacity-90.fs-5 Respaldo corporativo total con auditorías financieras y control estricto de accesos mediante perfiles cifrados.

          .d-flex.justify-content-between.align-items-center.mt-4.pt-3.border-top.border-secondary
            button.btn.btn-outline-light.btn-sm(onclick="prevSlide()") <i class="bi bi-chevron-left"></i> Anterior
            div.d-flex.gap-2
              span.badge.bg-secondary.rounded-circle(style="width: 10px; height: 10px;")
              span.badge.bg-secondary.rounded-circle(style="width: 10px; height: 10px;")
              span.badge.bg-secondary.rounded-circle(style="width: 10px; height: 10px;")
              span.badge.bg-secondary.rounded-circle(style="width: 10px; height: 10px;")
            button.btn.btn-outline-light.btn-sm(onclick="nextSlide()") Siguiente <i class="bi bi-chevron-right"></i>

      .mt-5
        a.btn.btn-kreo.btn-lg(href="/registro") ¡Empieza a Disfrutarlos Ahora!

    script.
      let currentSlide = 0;
      const slides = document.querySelectorAll('.slide-item');
      function showSlide(index) {
        slides.forEach((slide, i) => {
          slide.classList.remove('active');
          if(i === index) slide.classList.add('active');
        });
      }
      function nextSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showSlide(currentSlide);
      }
      function prevSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        showSlide(currentSlide);
      }
      setInterval(nextSlide, 5000);